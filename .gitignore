# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Env & secrets
.env
.env.*
!.env.example
# Git cannot re-include a file inside an excluded directory, so ignore the
# directory contents instead and re-include the *.example placeholders.
deploy/secrets/*
!deploy/secrets/*.example
*.pem
*.key

# Go
bin/
dist/
*.exe
*.test
*.out
coverage.*
vendor/

# Node / web
node_modules/
web/dist/
web/coverage/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Claude Code local settings
.claude/settings.local.json

# Misc
tmp/
*.log

# Stray `go build` output of the gateway (go build ./cmd/server in services/gateway)
services/gateway/server
