{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaymentFailed",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "PaymentFailed"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payment_id",
        "checkout_id",
        "provider",
        "reason"
      ],
      "properties": {
        "payment_id": {
          "type": "string",
          "format": "uuid"
        },
        "checkout_id": {
          "type": "string",
          "format": "uuid"
        },
        "provider": {
          "enum": [
            "vnpay",
            "stripe",
            "fake"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
